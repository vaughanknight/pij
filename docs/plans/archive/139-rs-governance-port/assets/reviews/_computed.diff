+fn replace_flag(request: &mut Value, name: &str, value: Value) {
+    let argv = request["argv"].as_array_mut().expect("argv");
+    if let Some(index) = argv.iter().position(|arg| arg == name) {
+        argv[index + 1] = value;
+    } else {
+        argv.extend([json!(name), value]);
+    }
+}
