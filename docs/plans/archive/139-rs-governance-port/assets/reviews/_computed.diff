+fn contract() -> &'static Value {
+    static CONTRACT: OnceLock<Value> = OnceLock::new();
+    CONTRACT.get_or_init(|| {
+        serde_json::from_str(include_str!(
+            "../../testkit/fixtures/golden/api/governance-routes.json"
+        ))
+        .expect("canonical route contract")
+    })
+}
