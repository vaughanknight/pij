     let adapter = ProcLiveness::new();
-    assert_eq!(
-        block_on(adapter.proc_start(u32::MAX)).expect("an out-of-range pid is observable absence"),
-        None
-    );
+    let error = block_on(adapter.proc_start(u32::MAX))
