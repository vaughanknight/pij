+fn case(id: &str) -> &'static Value {
+    contract()["routes"]
+        .as_array()
+        .expect("route array")
+        .iter()
+        .flat_map(|route| route["cases"].as_array().expect("case array"))
+        .find(|case| case["id"] == id)
+        .expect("named canonical fixture")
+}
