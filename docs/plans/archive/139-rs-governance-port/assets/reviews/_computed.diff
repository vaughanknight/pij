+    let mut altered = request.clone();
+    altered.pin = Some("different".into());
+    assert!(matches!(
+        store.request_baton(&altered).await.unwrap(),
+        GovernanceOutcome::Conflict { .. }
+    ));
+    assert_eq!(
+        store
+            .grant_baton(
+                &baton.name,
+                &request.id,
+                &expected.lease_id,
+                expected.acquired_at
