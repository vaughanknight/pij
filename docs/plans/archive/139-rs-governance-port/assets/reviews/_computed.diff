+        &'a self,
+        commit: pij_store::spine::RegistryCommit,
+    ) -> pij_store::spine::RegistryPublication<'a> {
+        self.entered.notify_one();
+        pij_store::spine::RegistryPublisher::publish_registry(self.bus.as_ref(), commit)
+    }
+}
