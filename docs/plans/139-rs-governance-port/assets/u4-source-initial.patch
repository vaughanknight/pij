+    assert!(!before["data"]["anomalies"].as_array().expect("rows").iter().any(|row| row["kind"] == "unverified-done"));
+    let later = value(addr,"/v1/report",&done_request).await;
+    let after = value(addr,"/v1/anomalies",&case(&fixtures,"anomalies-argv")["request"]).await;
+    let row = after["data"]["anomalies"].as_array().expect("rows").iter().find(|row| row["kind"] == "unverified-done").expect("new done is not verified");
+    assert_eq!(row["evidence"][0],later["data"]["seq"]);
