+            occurrence: occurrence(AnomalyKind::DeadSeat, &fact.seat, fact.seq), status: AnomalyStatus::Open,
+            detail: "recorded process incarnation is dead; inspect with pij-rs reap --dry-run".to_string(),
+            evidence: vec![fact.seq], assignment_id: None, record_ref: None, age_ms: None,
+        }).collect(), view.dispositions)
+    }
 }
 
