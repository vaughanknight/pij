+    let before = services.registry.put(expected.clone()).await.unwrap();
+    let mut replacement = expected;
+    let proc = replacement.proc.unwrap();
+    replacement.proc = Some(ProcIdentity { proc_start: proc.proc_start + 1, ..proc });
+    let live = RevivingProbe { registry: services.registry.clone(), replacement: replacement.clone(), calls: AtomicUsize::new(0) };
+    let receipt = reap(services.registry.as_ref(), &live, &FakeTmux::new(), false).await.unwrap();
+    assert_eq!(receipt.candidates.len(), 1);
+    assert!(receipt.reaped.is_empty());
+    assert_eq!(receipt.unverifiable[0].reason, "incarnation-changed");
