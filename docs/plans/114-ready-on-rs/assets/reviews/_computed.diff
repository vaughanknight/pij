+            parse_report(&argv(&[
+                "report", "now", "a", "b", "--state", "blocked", "--note", "why"
+            ])),
+            Ok(ReportCall::Now {
+                did: "a".to_string(),
+                next: "b".to_string(),
+                state: Some(SemanticState::Blocked),
