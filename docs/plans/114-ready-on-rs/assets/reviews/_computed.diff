+        .spine
+        .tail(Some(&SeatId::from(SEAT)), Seq(0))
+        .await
+        .expect("tail")
+        .into_iter()
+        .rev()
+        .find(|event| event.kind == CARD_EVENT_KIND)
+        .expect("a card event")
