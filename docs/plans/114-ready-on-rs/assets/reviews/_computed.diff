+    fn typescript_only_states_refuse_by_name_and_name_the_rs_vocabulary() {
+        for word in TS_ONLY_STATES {
+            let refusal =
+                parse_report(&argv(&["report", "state", word])).expect_err("rs has no such state");
+            assert!(refusal.contains(word), "{refusal}");
