+        Ok(seq) => {
+            let line = match declared {
+                Some(state) => match &note {
+                    Some(note) => format!("{seat} is {state:?}: {note} (spine {})", seq.0),
+                    None => format!("{seat} is {state:?} (spine {})", seq.0),
+                },
+                None => format!("{seat} cleared its declared state (spine {})", seq.0),
+            };
