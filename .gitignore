# minih runtime artifacts (per-run + global session state)
agents/*/runs/
agents/*/state/*
!agents/*/state/*.schema.json
!agents/*/state/.gitkeep
session-store.db
session-store.db-shm
session-store.db-wal
session-state/

# Local agent / tooling state
.chainglass/
.fs2/graph.pickle
.pi/pi-mono-build.txt
.pi/pi-fork-build.txt

# Generated review artifacts (raw computed diffs)
docs/plans/*/reviews/_computed.diff

# Pi install artifacts (third-party extension code; analog of node_modules)
.pi/git/
.pi/npm/
.pi/agent/
.pi/skills/flow-pair

# MCP server config (contains secrets — env-expand at runtime)
.mcp.json

# Untracked local notes / scratch
scratch/
context.md
research.md

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
# Worktrees symlink node_modules at the canonical checkout; a trailing-slash
# pattern only matches directories, so the symlink needs its own slash-less entry.
node_modules
jspm_packages/

# Agent scratch: briefs, reports and probes written per worktree.
.harness/temp/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Stray research-subagent scratch dropped at repo root (should go to /tmp or scratch/).
/progress.md

# flow-pair runtime ledger (mutable, gitignored; curated learnings committed separately)
.flow-pair/
.pi/skills/pij

# tool caches (per-machine, not project truth)
.serena/
.pi-subagents/

# python bytecode caches (harness scripts)
__pycache__/
*.pyc
