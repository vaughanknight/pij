{
	"name": "pij",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"pij": "harness/scripts/pij-cli.cjs",
		"flow-pair": "skills/flow-pair/lib/cli.ts"
	},
	"description": "Engineering harness for building pi extensions.",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./.pi/extensions"
		],
		"skills": [
			"./.pi/skills"
		],
		"prompts": [
			"./.pi/prompts"
		],
		"themes": [
			"./.pi/themes"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome check --write .",
		"new": "tsx harness/scripts/new-extension.ts",
		"smoke": "tsx harness/scripts/smoke.ts",
		"link": "tsx harness/scripts/link-global.ts",
		"pkg": "tsx harness/scripts/packages.ts",
		"snapshots:refresh": "tsx harness/scripts/snapshot-refresh.ts",
		"snapshots:check": "tsx harness/scripts/snapshot-check.ts",
		"windows:check": "tsx harness/scripts/windows-compat.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@github/copilot-sdk": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@github/copilot-sdk": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/node": "^22.0.0",
		"@types/picomatch": "^4.0.3",
		"tsx": "^4.23.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	},
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"dependencies": {
		"@grammyjs/files": "^1.2.0",
		"diff": "^8.0.0",
		"dotenv": "^17.4.2",
		"grammy": "^1.44.0",
		"minih": "github:AI-Substrate/minih#minih-v0.2.4",
		"picomatch": "^4.0.4",
		"unique-names-generator": "4.7.1"
	}
}
