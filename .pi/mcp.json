{
	"mcpServers": {
		"perplexity": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "@perplexity-ai/mcp-server"],
			"env": {
				"PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}",
				"PERPLEXITY_TIMEOUT_MS": "2000000"
			}
		},
		"flowspace": {
			"type": "stdio",
			"command": "fs2",
			"args": ["mcp"],
			"env": {}
		}
	}
}
