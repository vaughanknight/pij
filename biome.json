{
	"$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
	"files": {
		"includes": [
			"**",
			"!node_modules",
			"!dist",
			"!.pi/git",
			"!.pi/npm",
			"!.flow-pair",
			"!**/*.template",
			"!agents",
			"!docs/plans",
			"!scratch",
			"!.harness"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": { "noExplicitAny": "error" },
			"complexity": { "noForEach": "off" }
		}
	}
}
